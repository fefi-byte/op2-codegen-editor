        },
        {
          "kind": "setMusic",
          "songs": [
            "songPlymth11",
            "songPlymth21",
            "songEP41"
          ],
          "repeat_start": 0,
          "comment": "Playlist: 2x Plymouth, dann EP41 im Loop"
        }
      ]
    },
    {
      "name": "Bergbau",
      "folder": "Wirtschaft",
      "condition": "time",
      "marks": 3,
      "one_shot": true,
      "enabled_at_start": true,
      "comment": "Mine als geplantes Gebaeude (Anker Mine1) + Makro: Gruppe wird scharf und startet, sobald Mine+Smelter stehen",
      "actions": [
        {
          "kind": "message",
